PORT=3000
NODE_ENV=development

# MongoDB (escolha uma das opções)
# Para MongoDB local:
MONGODB_URI=mongodb://localhost:27017/finance_db

# Para MongoDB Atlas (substitua pela sua connection string):
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/finance_db

# JWT
JWT_SECRET=sua_chave_secreta_aqui_muito_segura_com_pelo_menos_32_caracteres
JWT_EXPIRES_IN=7d

# Database MySQL (mantido para referência, mas não será usado)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=finance_db